APP_NAME=NEXUS-M
APP_VERSION=1.0.0
ENVIRONMENT=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nexus_m
DATABASE_USER=postgres
DATABASE_PASSWORD=YOUR_POSTGRES_PASSWORD

API_HOST=127.0.0.1
API_PORT=8000

OPENAI_API_KEY=

VECTOR_DB_PATH=./data/vector_store

RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
SYNTHETIC_DATA_PATH=./data/synthetic

ANOMALY_THRESHOLD=3.0
DATA_QUALITY_THRESHOLD=95.0
RECONCILIATION_THRESHOLD=0.01
# Phase 26 — Google Cloud managed services
NEXUS_GCP_REGION=us-central1
NEXUS_VERTEX_MODEL=gemini-2.5-flash